# Copie para /etc/nginx/sites-available/crm e ajuste server_name.
# TLS: depois do arquivo HTTP funcionar, rode certbot --nginx -d SEU_DOMINIO
#
# Só 80 e 443 devem ser públicos. Postgres (5432), Redis (6379) e Next (3001)
# já estão em 127.0.0.1 neste repositório — não publique essas portas.

upstream crm_next {
    server 127.0.0.1:3001;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name SEU_DOMINIO;

    client_max_body_size 25m;

    location / {
        proxy_pass http://crm_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
