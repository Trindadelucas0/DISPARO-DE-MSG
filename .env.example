# Copie para .env e preencha com os valores reais. O .env está no .gitignore.
# Nenhuma destas variáveis é exposta ao navegador: não use prefixo NEXT_PUBLIC_ em credencial.
#
# POSTGRES_PASSWORD e a senha dentro de DATABASE_URL têm que ser IGUAIS.
# Evite @ : / # % na senha (quebram a URL). Troque os placeholders antes de subir.

# Credenciais do container crm-postgres (docker compose).
POSTGRES_USER="crm"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"
POSTGRES_DB="crm_prospeccao"

# Next.js no host (systemd) fala com o Postgres publicado em 127.0.0.1:5432.
# O container crm-worker ignora este host e usa o serviço `postgres` da rede Docker.
DATABASE_URL="postgresql://crm:troque-por-uma-senha-forte@127.0.0.1:5432/crm_prospeccao?schema=public"

# Redis do Compose publicado em 127.0.0.1:6379. Campanhas, filas e o QR EXIGEM Redis.
# Cache e rate limit degradam sem Redis. O worker no container usa redis://redis:6379.
REDIS_URL="redis://127.0.0.1:6379"

# Segredo do Auth.js v5 (32 bytes aleatórios em base64).
# Gere com `npm run auth:secret`, que grava direto no .env sem exibir o valor.
# Não use `npx auth secret`: hoje esse nome resolve para o CLI de outro projeto (better-auth)
# e imprime o segredo no terminal.
AUTH_SECRET="troque-por-um-segredo-de-32-bytes-em-base64"

# Obrigatório atrás do Nginx (ou qualquer proxy).
AUTH_TRUST_HOST="true"

# URL pública HTTPS. Tem que ser exatamente a URL que o usuário abre no navegador.
AUTH_URL="https://SEU_DOMINIO"

# Credenciais do usuário admin criado pelo seed (prisma/seed.ts).
# Defina uma senha forte (mínimo 10 caracteres). O seed não sobrescreve senha já gravada.
SEED_ADMIN_EMAIL="admin@crm.local"
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"
SEED_ADMIN_NAME="Administrador"

# Chatwoot como gateway HTTP (opcional). O fluxo padrão é WhatsApp Web (QR) no crm-worker.
# CHATWOOT_BASE_URL="https://chatwoot.exemplo"
# CHATWOOT_API_TOKEN=""
# CHATWOOT_ACCOUNT_ID=""
# CHATWOOT_WEBHOOK_SECRET=""

# Evolution API (opcional, só contas antigas com provider EVOLUTION).
# Não é necessário para conectar QR nem para disparar campanha.
# EVOLUTION_API_URL="http://localhost:8080"
# EVOLUTION_API_KEY="change-me-evolution-key"
# EVOLUTION_WEBHOOK_SECRET="defina-um-segredo-forte"
