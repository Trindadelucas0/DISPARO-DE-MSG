# Copie para .env e preencha com os valores reais. O .env está no .gitignore.
# Nenhuma destas variáveis é exposta ao navegador: não use prefixo NEXT_PUBLIC_ em credencial.
#
# Este arquivo cobre os dois ambientes do MESMO sistema (CRM = disparo).
# Defaults abaixo = Windows local. Bloco VPS no final, comentado.

# PostgreSQL: no Windows local, serviço nativo (postgresql-x64-18, porta 5432).
# O banco crm_prospeccao deve existir: CREATE DATABASE crm_prospeccao;
DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:5432/crm_prospeccao?schema=public"

# Redis + worker Baileys no Windows: `docker compose up -d` (crm-redis :6380 e crm-worker).
# Cache e rate limit degradam sem Redis. Campanhas, filas e o QR WhatsApp EXIGEM Redis.
# O Next na máquina usa esta URL. O container crm-worker ignora o loopback e fala com redis:6379.
REDIS_URL="redis://127.0.0.1:6380"

# Segredo do Auth.js v5 (32 bytes aleatórios em base64).
# Gere com `npm run auth:secret`, que grava direto no .env sem exibir o valor.
# Não use `npx auth secret`: hoje esse nome resolve para o CLI de outro projeto (better-auth)
# e imprime o segredo no terminal.
AUTH_SECRET="troque-por-um-segredo-de-32-bytes-em-base64"

# Necessário quando a aplicação roda atrás de proxy ou em host diferente de localhost.
AUTH_TRUST_HOST="true"

# URL pública da aplicação (Auth.js). Local: 3001 para não colidir com outros sistemas na 3000.
AUTH_URL="http://localhost:3001"

# Credenciais do usuário admin criado pelo seed (prisma/seed.ts).
SEED_ADMIN_EMAIL="admin@crm.local"
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"
SEED_ADMIN_NAME="Administrador"

# Chatwoot como gateway HTTP (opcional). Sem isso, use MOCK ou WhatsApp Web (QR).
# CHATWOOT_BASE_URL="https://chatwoot.exemplo"
# CHATWOOT_API_TOKEN=""
# CHATWOOT_ACCOUNT_ID=""
# CHATWOOT_WEBHOOK_SECRET=""

# QR WhatsApp Web: gerado pelo container crm-worker (`docker compose up -d`).
# Não rode `npm run worker` no terminal ao mesmo tempo. Não precisa de
# EVOLUTION_API_KEY. Sessão em disco (gitignored): data/whatsapp-auth/<accountId>/
# Evolution API permanece opcional só para contas antigas com provider EVOLUTION.
# EVOLUTION_API_URL="http://localhost:8080"
# EVOLUTION_API_KEY="change-me-evolution-key"
# EVOLUTION_WEBHOOK_SECRET="defina-um-segredo-forte"

# ---------------------------------------------------------------------------
# VPS (`/opt/disparo-de-msg`) — descomente e ajuste. Não use os defaults Windows.
#
# COMPOSE_FILE=docker-compose.vps.yml
# POSTGRES_USER="crm"
# POSTGRES_PASSWORD="troque-por-uma-senha-forte"
# POSTGRES_DB="crm_prospeccao"
# DATABASE_URL="postgresql://crm:troque-por-uma-senha-forte@127.0.0.1:5432/crm_prospeccao?schema=public"
# REDIS_URL="redis://127.0.0.1:6379"
# AUTH_URL="https://SEU_DOMINIO"
#
# POSTGRES_PASSWORD e a senha dentro de DATABASE_URL têm que ser IGUAIS.
# Evite @ : / # % na senha (quebram a URL).
# Compose da VPS: docker compose -f docker-compose.vps.yml up -d
# (ou COMPOSE_FILE acima). Não use docker-compose.yml nem docker-compose.postgres.yml
# na VPS: porta Redis e volume do Postgres são outros (crm_pg_data / 6379).
# ---------------------------------------------------------------------------
