# Worker Baileys + filas BullMQ. O Next continua na máquina (porta 3001).
# Postgres nativo (5432). Redis é o serviço `redis` deste Compose.

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY tsconfig.json ./

# tsx e prisma CLI estão em devDependencies; o worker precisa dos dois.
RUN npm ci

COPY src ./src
COPY workers ./workers

RUN npx prisma generate

CMD ["sh", "-c", "npx prisma generate && exec npx tsx workers/index.ts"]
